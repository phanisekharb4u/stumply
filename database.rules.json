{
  "rules": {
    ".read": false,
    ".write": false,
    "tournaments": {
      "$tid": {
        ".read": true,
        ".write": "auth != null && (data.exists() ? data.child('owner').val() === auth.uid : (newData.child('owner').val() === auth.uid && (root.child('owners').child(auth.uid).val() === true || (newData.parent().parent().child('quota').child(auth.uid).child('used').exists() && (!root.child('quota').child(auth.uid).child('used').exists() || newData.parent().parent().child('quota').child(auth.uid).child('used').val() > root.child('quota').child(auth.uid).child('used').val())) || (!root.child('quota').child(auth.uid).child('first').exists() && newData.parent().parent().child('quota').child(auth.uid).child('first').val() === true))))",
        "owner": {
          ".validate": "newData.val() === auth.uid"
        },
        "ownerName": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "meta": {
          ".validate": "newData.isString() && newData.val().length <= 4000"
        },
        "teams": {
          ".validate": "newData.isString() && newData.val().length <= 400000"
        },
        "order": {
          ".write": "auth != null && root.child('tournaments').child($tid).child('scorers').child(auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().length <= 40000"
        },
        "liveId": {
          ".write": "auth != null && root.child('tournaments').child($tid).child('scorers').child(auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "_savedAt": {
          ".write": "auth != null && root.child('tournaments').child($tid).child('scorers').child(auth.uid).exists()",
          ".validate": "newData.isNumber()"
        },
        "matches": {
          "$mid": {
            ".write": "auth != null && root.child('tournaments').child($tid).child('scorers').child(auth.uid).exists()",
            ".validate": "$mid.matches(/^[A-Za-z0-9_-]{1,80}$/) && newData.isString() && newData.val().length <= 400000"
          }
        },
        "photos": {
          "$pid": {
            ".validate": "$pid.matches(/^[A-Za-z0-9_-]{1,80}$/) && newData.isString() && newData.val().length <= 60000 && newData.val().beginsWith('data:image/')"
          }
        },
        "live": {
          ".write": "auth != null && root.child('tournaments').child($tid).child('scorers').child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['rev'])",
          "rev": {
            ".validate": "newData.isNumber()"
          },
          "mid": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "m": {
            ".validate": "newData.isString() && newData.val().length <= 400000"
          },
          "$other": {
            ".validate": false
          }
        },
        "scorers": {
          "$uid": {
            ".validate": "$uid.matches(/^[A-Za-z0-9_-]{1,80}$/) && newData.hasChildren(['uname'])",
            "uname": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        },
        ".validate": "$tid.matches(/^[A-Za-z0-9_-]{1,80}$/) && newData.hasChildren(['owner','meta'])"
      }
    },
    "userTournaments": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid",
        "$tid": {
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "edition": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "year": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "live": {
            ".write": "auth != null && root.child('tournaments').child($tid).child('owner').val() === $uid && root.child('tournaments').child($tid).child('scorers').child(auth.uid).exists()",
            ".validate": "newData.isBoolean()"
          },
          "updatedAt": {
            ".write": "auth != null && root.child('tournaments').child($tid).child('owner').val() === $uid && root.child('tournaments').child($tid).child('scorers').child(auth.uid).exists()",
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          },
          ".validate": "$tid.matches(/^[A-Za-z0-9_-]{1,80}$/)"
        }
      },
      ".read": "auth != null && root.child('owners').child(auth.uid).val() === true"
    },
    "usernames": {
      "$uname": {
        ".read": true,
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
        ".validate": "$uname.matches(/^[a-z0-9_]{3,30}$/) && newData.isString()"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "uname": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      },
      ".read": "auth != null && root.child('owners').child(auth.uid).val() === true"
    },
    "owners": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "public": {
      ".read": true,
      ".indexOn": [
        "updatedAt"
      ],
      "$tid": {
        ".write": "auth != null && root.child('tournaments').child($tid).child('owner').val() === auth.uid",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "edition": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "city": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "by": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "teams": {
          ".validate": "newData.isNumber()"
        },
        "live": {
          ".write": "auth != null && data.parent().exists() && root.child('tournaments').child($tid).child('scorers').child(auth.uid).exists()",
          ".validate": "newData.isBoolean()"
        },
        "updatedAt": {
          ".write": "auth != null && data.parent().exists() && root.child('tournaments').child($tid).child('scorers').child(auth.uid).exists()",
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        },
        ".validate": "$tid.matches(/^[A-Za-z0-9_-]{1,80}$/) && newData.hasChildren(['name','updatedAt'])"
      }
    },
    "polls": {
      "$tid": {
        ".write": "auth != null && root.child('tournaments').child($tid).child('owner').val() === auth.uid && !newData.exists()",
        "$mid": {
          ".read": true,
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('tournaments').child($tid).exists()",
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,80}$/)"
          }
        }
      }
    },
    "quota": {
      ".read": "auth != null && root.child('owners').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "used": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1 && (newData.val() <= 3 || (newData.parent().child('credits').exists() && newData.val() <= 3 + newData.parent().child('credits').val()))"
        },
        "first": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.val() === true"
        },
        "credits": {
          ".write": "auth != null && root.child('owners').child(auth.uid).val() === true",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "payments": {
      ".read": "auth != null && root.child('owners').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$pid": {
          ".write": "auth != null && ((auth.uid === $uid && !data.exists()) || root.child('owners').child(auth.uid).val() === true)",
          ".validate": "$pid.matches(/^[A-Za-z0-9_-]{1,40}$/) && newData.hasChildren(['utr','amount','at','status'])",
          "utr": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{6,30}$/)"
          },
          "amount": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100000"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "uname": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "status": {
            ".validate": "newData.isString() && (newData.val() === 'pending' || (root.child('owners').child(auth.uid).val() === true && (newData.val() === 'approved' || newData.val() === 'rejected')))"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "config": {
      ".read": true,
      "pay": {
        ".write": "auth != null && root.child('owners').child(auth.uid).val() === true",
        "vpa": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9._-]{2,256}@[A-Za-z0-9.-]{2,64}$/)"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "price": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "scorerOf": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$tid": {
          ".write": "auth != null && ((auth.uid === $uid && !newData.exists()) || root.child('tournaments').child($tid).child('owner').val() === auth.uid)",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "ownerName": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "owner": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "$other": {
            ".validate": false
          },
          ".validate": "$tid.matches(/^[A-Za-z0-9_-]{1,80}$/) && newData.hasChildren(['name','owner'])"
        }
      }
    }
  }
}
