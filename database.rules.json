{
  "rules": {
    ".read": false,
    ".write": false,
    "tournaments": {
      "$tid": {
        ".read": true,
        ".write": "auth != null && (data.exists() ? data.child('owner').val() === auth.uid : newData.child('owner').val() === auth.uid)",
        "owner": {
          ".validate": "newData.val() === auth.uid"
        },
        "ownerName": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "meta": {
          ".validate": "newData.isString() && newData.val().length <= 4000"
        },
        "teams": {
          ".validate": "newData.isString() && newData.val().length <= 400000"
        },
        "order": {
          ".validate": "newData.isString() && newData.val().length <= 40000"
        },
        "liveId": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "_savedAt": {
          ".validate": "newData.isNumber()"
        },
        "matches": {
          "$mid": {
            ".validate": "$mid.matches(/^[A-Za-z0-9_-]{1,80}$/) && newData.isString() && newData.val().length <= 400000"
          }
        },
        "photos": {
          "$pid": {
            ".validate": "$pid.matches(/^[A-Za-z0-9_-]{1,80}$/) && newData.isString() && newData.val().length <= 60000 && newData.val().beginsWith('data:image/')"
          }
        },
        "$other": {
          ".validate": false
        },
        ".validate": "$tid.matches(/^[A-Za-z0-9_-]{1,80}$/) && newData.hasChildren(['owner','meta'])"
      }
    },
    "userTournaments": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid",
        "$tid": {
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "edition": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "year": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "live": {
            ".validate": "newData.isBoolean()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          },
          ".validate": "$tid.matches(/^[A-Za-z0-9_-]{1,80}$/)"
        }
      },
      ".read": "auth != null && root.child('owners').child(auth.uid).val() === true"
    },
    "usernames": {
      "$uname": {
        ".read": true,
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
        ".validate": "$uname.matches(/^[a-z0-9_]{3,30}$/) && newData.isString()"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "uname": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      },
      ".read": "auth != null && root.child('owners').child(auth.uid).val() === true"
    },
    "owners": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    }
  }
}
